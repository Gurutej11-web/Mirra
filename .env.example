# Copy this file to .env.local and fill in your own values.

# Groq (vision tagging, Fit Score, stylist chat) — https://console.groq.com
GROQ_API_KEY=

# Supabase — Project Settings → API Keys / Connect
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# remove.bg (clean clothing cutouts) — https://www.remove.bg/api
REMOVE_BG_API_KEY=

# Replicate (realistic try-on) — https://replicate.com
REPLICATE_API_TOKEN=
