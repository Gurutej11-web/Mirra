{
  "name": "Mirra — AI closet & stylist",
  "short_name": "Mirra",
  "description": "Your closet, an avatar to try outfits on, and an honest AI Fit Score.",
  "start_url": "/home",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0b0a0c",
  "theme_color": "#0b0a0c",
  "categories": ["lifestyle", "shopping"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Fit Check", "url": "/fit-check", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Add to closet", "url": "/closet/add", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Stylist", "url": "/stylist", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
